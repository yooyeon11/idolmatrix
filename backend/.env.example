# ===== 应用 =====
APP_NAME=K-pop Media Library
DEBUG=true

# ===== 数据库 =====
# 默认 SQLite，切换 PostgreSQL 改为：
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/kpop_media
DATABASE_URL=sqlite:///./data/kpop_media.db

# ===== 存储路径（相对项目根目录或绝对路径）=====
# 待整理：扫描入口
STORAGE_INCOMING_DIR=./storage/incoming
# 正式库：入库后文件存放
STORAGE_LIBRARY_DIR=./storage/library
# 派生产物：转码文件、封面截图
STORAGE_DERIVED_DIR=./storage/derived

# 正式库目录结构模板（可用变量：{group}/{artist}/{song}/{video_type}/{year}）
# 仅在入库移动文件时使用，留空则平铺到 LIBRARY_DIR/<group>/<title>
LIBRARY_PATH_TEMPLATE=

# ===== FFmpeg / ffprobe =====
# 留空则自动从 PATH 检测；Windows 可填绝对路径如 C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=
FFPROBE_PATH=

# ===== 转码默认参数 =====
TRANSCODE_VIDEO_CODEC=libx264
TRANSCODE_VIDEO_PRESET=veryfast
TRANSCODE_VIDEO_CRF=23
TRANSCODE_AUDIO_CODEC=aac
TRANSCODE_AUDIO_BITRATE=192k
TRANSCODE_SCALE=1280:-2

# ===== 跨域 =====
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ===== 跨站写请求放行（CSRF Origin 校验开关）=====
# 默认 false 严格校验。通过内网穿透(节点小宝/NAS 隧道)或非常规域名访问时，
# 若写操作报 403「跨站请求被拒绝」，才在可信网络下置 true。
# ⚠ 2026-09-17 起设置页的开关已移除，这里是**唯一**入口，改完须重启后端。
ALLOW_CROSS_ORIGIN_WRITES=false

# ===== 站点获取（TheAudioDB） =====
# 免费测试 Key 为 "2"（检索仅限测试数据，如 coldplay）；正式使用请到 theaudiodb.com 注册后替换
AUDIODB_API_KEY=2
AUDIODB_BASE_URL=https://www.theaudiodb.com/api/v1/json
# 接口请求超时（秒）
AUDIODB_TIMEOUT=15
# 头像图片下载超时（秒）
AUDIODB_IMAGE_TIMEOUT=30
