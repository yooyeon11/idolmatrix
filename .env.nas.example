# =============================================================
# 绿联 NAS 部署 —— 可选的环境变量文件
#
# 用法：把本文件复制为 .env，放在 docker-compose.yml 同目录：
#   cp .env.nas.example .env
# 然后执行 docker compose up -d（镜像需先 docker load 导入，不要加 --build）
#
# 不创建 .env 也可以：docker-compose.yml 内置了默认值 /volume1/kpop/*，
# 直接编辑 docker-compose.yml 中的对应行同样生效。
# =============================================================

# ★ 待整理文件夹（把视频丢进来 → 前端「待整理」页扫描入库）
INCOMING_DIR=/volume1/kpop/incoming

# ★ 正式库文件夹（入库后的视频文件存放位置）
LIBRARY_DIR=/volume1/kpop/library

# ★ 派生文件（缩略图 / 转码产物）
DERIVED_DIR=/volume1/kpop/derived

# ★ MT Photos 图库目录（官方/粉丝按帖展示要读 sidecar txt，必须能在容器内看到）
#   填 MT Photos 扫描的那份照片根目录，例如 /volume1/photo
#   容器内路径固定为 /data/mt-photos（只读）
#   设置里「MT 磁盘路径前缀」填 MT 网页里看到的同一路径开头
MT_PHOTOS_DIR=/volume1/photo

# ★ SQLite 数据库目录（★必须挂卷，否则容器删除/重建会丢失全部数据）
#   数据库实际文件为 DB_DIR/kpop_media.db（容器内 /data/db/kpop_media.db）
DB_DIR=/volume1/kpop/db

# ==== SQLite 备份（NAS 上定期执行，推荐用 sqlite3 在线备份）====
#   挂卷中的数据库在运行时可安全在线备份：
#     sqlite3 /volume1/kpop/db/kpop_media.db ".backup '/volume1/kpop/db/kpop_media.backup.db'"
#   建议用 cron 定时备份，例如每天 03:00：
#     0 3 * * * sqlite3 /volume1/kpop/db/kpop_media.db ".backup '/volume1/kpop/db/kpop_media.backup.db'"
#   注意：
#     - 数据库启用了 WAL 模式，直接 cp 拷贝 .db 文件可能漏掉 WAL 中的提交；
#       请务必用 sqlite3 .backup 或先停止容器再拷贝。
#     - 备份文件与 .db 同样在挂卷内，不会随容器删除而丢失。

# ★ 对外访问端口（默认 8010；如被占用可改，如 18010）
# HOST_PORT=8010

# ==== 登录门禁（2.2.0）====
# 默认必须登录。首次部署在局域网打开 http://<NAS-IP>:<端口>/setup 创建唯一账号。
# 经公网 IP / 域名初始化必须配置 BOOTSTRAP_TOKEN，建号后务必删除：
# BOOTSTRAP_TOKEN=请换成随机长字符串
# 无头创建（用完删除）：
# BOOTSTRAP_OWNER_USERNAME=owner
# BOOTSTRAP_OWNER_PASSWORD=
# 紧急关闭门禁（回到匿名，仅救火）：
# AUTH_REQUIRED=false
# 忘记密码：docker exec -it kpop-media python -m app.cli reset-owner-password
# 不要把 BOOTSTRAP_* / AUTH_RESET_OWNER_PASSWORD 长期留在 compose（docker inspect 能看见）

# ★ 跨站写请求放行（全局开关）
#   false（默认）= 严格 CSRF；true = 放行跨站写请求。
#   通过 节点小宝/内网穿透 等外部域名访问、报「跨站请求被拒绝」(403) 时设为 true。
#   登录 Cookie 基于此放开，请仅在可信网络使用。也可在设置页由主账号开关。
# ALLOW_CROSS_ORIGIN_WRITES=false

# 反代在容器前时填写反代 IP，登录限流才会认 X-Forwarded-For（直连 NAS 不用填）：
# AUTH_TRUSTED_PROXIES=172.17.0.1

# 时区
# TZ=Asia/Shanghai

# ★ 硬件转码（Intel 核显 VAAPI 硬编）
#   auto ：自动探测 VAAPI，无核显/无设备时自动回退软件转码（推荐，默认值）
#   vaapi：强制 VAAPI（探测失败则回退软件）
#   qsv  ：强制 QSV 完整硬解硬编（12 代核显上不稳定，仅供试验）
#   none / cpu：禁用硬件转码，强制软件转码
#   前提：NAS 宿主机存在 /dev/dri/renderD128（绿联一般自带；可用 ls -la /dev/dri 确认）
TRANSCODE_HWACCEL=auto
