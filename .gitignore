idolmatrix-*.tar
*.tar
*.tar.gz
*.tgz

# ===== 第三方二进制：jellyfin-ffmpeg 运行时 =====
# 属第三方产物且超 GitHub 单文件 100MB 上限，不入版本库。
# 需要重新构建镜像时，用一条命令抓取并落地（自动解包，不产生符号链接）：
#   python scripts/fetch_jellyfin_ffmpeg.py --tag v8.1.2-5 --flavor deb --apply docker/jellyfin
# 详见 scripts/fetch_jellyfin_ffmpeg.py 顶部说明。
docker/jellyfin/
# 抓取脚本的下载缓存与解包暂存（体积大，勿入库）
.ffmpeg-dist/

